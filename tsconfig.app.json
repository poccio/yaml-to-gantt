{
  // Browser code, bundled by Vite — so `bundler` resolution, which makes
  // extensionless relative imports legal here and nowhere else in the repo.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "paths": {
      "react": ["./node_modules/preact/compat"],
      "react-dom": ["./node_modules/preact/compat"]
    },

    // Without this, every @types package on disk is visible: `process.env` in a
    // component typechecks clean and then breaks in the browser.
    "types": [],

    "noEmit": true,
    "incremental": true,
    "tsBuildInfoFile": ".tsbuild/app.tsbuildinfo"
  },
  "include": ["src"]
}
