{
  "name": "yaml-to-gantt",
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.0.9",
  "description": "Visualize a YAML roadmap as an interactive Gantt chart",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/poccio/yaml-to-gantt"
  },
  "bin": {
    "yaml-to-gantt": "./dist-server/bin/cli.js"
  },
  "files": [
    "dist-server",
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build && pnpm build:server",
    "build:server": "tsc --build tsconfig.server.json --force",
    "typecheck": "tsc --build",
    "test": "vitest run",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "sirv": "^3.0.0"
  },
  "devDependencies": {
    "@preact/compat": "^17.1.2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "js-yaml": "^4.1.0",
    "jsdom": "^30.0.0",
    "playwright": "^1.61.0",
    "preact": "^10.25.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^6.0.3",
    "vite": "^6.3.1",
    "vitest": "^3.1.1"
  }
}